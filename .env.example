# Copy this to .env and fill in your values.
# Never commit .env — it is gitignored.

# Supabase
# Session pooler (IPv4; the direct db.<ref>.supabase.co host is IPv6-only and unreachable from WSL2)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Anthropic (only needed for categorize_markets.py)
ANTHROPIC_API_KEY=your-anthropic-api-key

# AWS S3 (data lake — parquet files)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_DATA_PREFIX=data
