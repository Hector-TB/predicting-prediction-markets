# Data files — live on S3, not in git (see ADR-012)
# Versioned on S3 with data/sync.py (ADR-016): list / status / pull / publish
data/*.parquet
data/*.csv
data/fetch_cache/
# which dataset version is checked out locally (git has no inline comments)
data/manifest.json
# settings of the snapshot build in progress (build_snapshots.py resume guard)
data/*.build.json
# when the markets were last fetched — published with the dataset version (ADR-020)
data/fetch_state.json
data/*.bak.csv

# Notebooks
testing.ipynb
.ipynb_checkpoints/

# Model artifacts (large binaries)
models/*/artifacts/*.pkl
models/*/artifacts/*.joblib
models/*/artifacts/*.txt
models/*/artifacts/*.bin
models/*/artifacts/*.parquet

# Test-set predictions — on S3 via scripts/sync_predictions.py (ADR-019 amendment)
models/*/predictions/*.csv

# Results JSON (keep these — small and useful to share)
# models/*/results/*.json  ← intentionally NOT ignored

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# EDA
eda.ipynb
.DS_Store
.env

# Pipeline run logs
logs/
